{
  "name": "Agent Trader Dev Container",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/agent-trader",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "uv sync"
  // "remoteUser": "vscode"
  // Using docker-compose; workspace will be mounted automatically by Dev Containers.
}
